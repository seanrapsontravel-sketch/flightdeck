# Dependencies
node_modules/

# Local runtime data (player roster + avatars + secrets)
data/

# Local TLS material (do not commit private keys)
certs/

# Runtime log from run.sh
.run.log

# Local image / clip tooling (keep venvs outside the game tree when possible)
.venv-img/
.venv-ytdlp/

# macOS Finder junk
.DS_Store
**/.DS_Store
.tmp-verify/

# Browser verification artifacts, and other generated output (before/after comparison sheets etc.)
output/
test-results/
playwright-report/

# Generated look-dev / review renders (hundreds of MB; each set regenerates from one command in docs/plans/tools/)
# and third-party reference photos (reference only, never shipped)
docs/plans/*-lookdev/
docs/plans/intros/
