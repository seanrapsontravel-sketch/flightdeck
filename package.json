{
  "name": "flightdeck",
  "version": "0.25.0",
  "description": "A control panel + kiosk display for running a real dartboard as a party/venue game system.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "SCORING_MODE=mock PORT=4000 nodemon src/server.js",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "check": "node scripts/check.js",
    "setup": "node scripts/setup.js",
    "setup:trusted": "node scripts/setup.js --trusted"
  },
  "keywords": [],
  "author": "Richie Lai",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "express": "5.3.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "nodemon": "3.1.11"
  }
}
